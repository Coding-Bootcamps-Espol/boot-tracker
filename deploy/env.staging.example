# Plantilla del .env de STAGING.
# Destino: /opt/boot-tracker-staging/.env   ·   Dueño: deploy:deploy   ·   Permisos: 600
#
# ⚠️ Sólo la plantilla: los valores reales nunca van en git.
# ⚠️ NINGÚN secreto se comparte con producción: SECRET_KEY, DB_PASSWORD y
#    JELOU_BOT_TOKEN se generan aparte. Si staging se filtra, prod no cae con él.

# --- Entorno -----------------------------------------------------------------
# APP_ENV=staging es lo que habilita `anonymize_for_staging`. En prod no existe.
APP_ENV=staging
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CAMBIAR

ALLOWED_HOSTS=boottracker-staging.codingbootcampslatam.com,localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=https://boottracker-staging.codingbootcampslatam.com
CORS_ALLOWED_ORIGINS=https://boottracker-staging.codingbootcampslatam.com
FRONTEND_URL=https://boottracker-staging.codingbootcampslatam.com
WEBHOOK_DOMAIN=https://boottracker-staging.codingbootcampslatam.com

# --- Contenedores (los lee docker-compose.hetzner.yml) -----------------------
# deploy.sh exporta IMAGE_TAG=<sha> y le gana a este valor; queda para los
# `docker compose` manuales (p. ej. refresh-staging-db.sh).
IMAGE_TAG=staging
FRONTEND_PORT=8085
MAILPIT_UI_PORT=8086
GUNICORN_WORKERS=1
CELERY_CONCURRENCY=1

# --- Base de datos -----------------------------------------------------------
# DB_NAME DISTINTO de prod: anonymize_for_staging y refresh-staging-db.sh se niegan
# a correr si coincide con 'boottracker'.
DB_NAME=boottracker_staging
DB_USER=boottracker_staging
#   openssl rand -base64 32
DB_PASSWORD=CAMBIAR
DB_HOST=db
DB_PORT=5432
REDIS_URL=redis://redis:6379/0

# Contraseña que anonymize_for_staging le pone a TODAS las cuentas. Mínimo 8.
STAGING_DEFAULT_PASSWORD=CAMBIAR

# --- Email: todo va a Mailpit, nada sale a internet --------------------------
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=staging
EMAIL_HOST_PASSWORD=staging
DEFAULT_FROM_EMAIL=no-reply@staging.test

# --- Google Calendar ---------------------------------------------------------
# Un calendario APARTE, compartido con la service account. Si se deja el de prod,
# las reuniones que se creen en staging aparecen en el calendario real.
GOOGLE_APPLICATION_CREDENTIALS=/app/google-credentials.json
GOOGLE_CALENDAR_ID=CAMBIAR

# --- Bot de WhatsApp (Jelou) -------------------------------------------------
# Vacío = los endpoints del bot rechazan todo. Sólo se completa si se arma un bot
# de pruebas en Jelou; nunca con el token de producción.
JELOU_BOT_TOKEN=
